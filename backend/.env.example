PORT=4000

# Cloudinary credentials (backend only)
CLOUD_NAME=
API_KEY=
API_SECRET=

# Firebase Admin SDK credentials (SERVER-SIDE ONLY - NEVER EXPOSE TO CLIENT)
# These are extracted from your Firebase service account JSON key
# Get these values from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=company-website-f3fdc
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@company-website-f3fdc.iam.gserviceaccount.com
# IMPORTANT: In .env.local, the private key should have literal \n (not escaped)
# Example format:
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...YOUR_KEY_HERE...END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=https://company-website-f3fdc-default-rtdb.firebaseio.com
