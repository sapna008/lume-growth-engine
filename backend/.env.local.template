# ============================================================================
# Firebase Admin SDK Configuration (.env.local)
# ============================================================================
# SECURITY: This file contains sensitive credentials. NEVER commit to git.
# This is a TEMPLATE showing which values to fill in from your service account.
#
# To set up:
# 1. Copy this file to backend/.env.local
# 2. Extract values from your Firebase service account JSON key:
#    - Go to Firebase Console > Project Settings > Service Accounts
#    - Generate a new private key (or use existing)
#    - Download the JSON file
# 3. Fill in the values from the JSON file (see mapping below)
# 4. Ensure .env.local is in .gitignore (it is by default)
# ============================================================================

# Port for the Content Management API
PORT=4000

# Cloudinary Configuration (for media uploads)
CLOUD_NAME=
API_KEY=
API_SECRET=

# ============================================================================
# Firebase Admin SDK Credentials (SERVER-SIDE ONLY)
# ============================================================================
# CRITICAL: These credentials should ONLY exist on your server.
# NEVER expose these to the client/browser.
# NEVER commit these to version control.
# ============================================================================

# From service account JSON: "project_id"
FIREBASE_PROJECT_ID=company-website-f3fdc

# From service account JSON: "client_email"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@company-website-f3fdc.iam.gserviceaccount.com

# From service account JSON: "private_key"
# IMPORTANT: Keep the literal \n characters (do NOT convert to actual newlines)
# The config will handle the conversion
# Example:
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSj...LONG_KEY_HERE...-----END PRIVATE KEY-----\n
FIREBASE_PRIVATE_KEY=

# Firebase Realtime Database URL
# From service account JSON: Look in "databaseURL" or construct from project_id
FIREBASE_DATABASE_URL=https://company-website-f3fdc-default-rtdb.firebaseio.com

# ============================================================================
# Setup Instructions
# ============================================================================
# 1. Rename this file to .env.local (remove .template extension)
# 2. Get your Firebase service account JSON from Firebase Console
# 3. Extract these values from the JSON file:
#    - project_id → FIREBASE_PROJECT_ID
#    - client_email → FIREBASE_CLIENT_EMAIL
#    - private_key → FIREBASE_PRIVATE_KEY (keep the \n as literal \n)
# 4. Save the file
# 5. Start your backend: npm run api:dev
#
# Once configured, the Firebase Admin SDK will:
# - Be initialized on server startup
# - Only be available server-side (never bundled to client)
# - Provide Firestore access for your content management API
# ============================================================================
